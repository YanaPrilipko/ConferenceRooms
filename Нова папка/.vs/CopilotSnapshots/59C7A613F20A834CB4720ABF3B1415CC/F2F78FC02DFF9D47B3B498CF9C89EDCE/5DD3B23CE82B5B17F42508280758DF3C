using ConferenceRooms.Contracts;
using ConferenceRooms.Services;
using ConferenceRooms.Services.Results;
using Microsoft.AspNetCore.Mvc;

namespace ConferenceRooms.Controllers;

/// <summary>
/// Provides endpoints for managing conference rooms.
/// </summary>
[ApiController]
[Route("api/rooms")]
[Produces("application/json")]
public class RoomsController(IConferenceRoomService service) : ControllerBase
{
    /// <summary>
    /// Returns all conference rooms.
    /// </summary>
    /// <returns>List of conference rooms.</returns>
    [HttpGet]
    [ProducesResponseType(typeof(IReadOnlyCollection<RoomDto>), StatusCodes.Status200OK)]
    [ProducesResponseType(typeof(ApiErrorDto), StatusCodes.Status500InternalServerError)]
    public IActionResult GetRooms()
    {
        var rooms = service.GetRooms();
        return Ok(rooms);
    }

    /// <summary>
    /// Creates a new conference room.
    /// </summary>
    /// <param name="request">Conference room data.</param>
    /// <returns>Created room identifier and status message.</returns>
    [HttpPost]
    [Consumes("application/json")]
    [ProducesResponseType(typeof(ApiMessageDto), StatusCodes.Status201Created)]
    [ProducesResponseType(typeof(ValidationProblemDetails), StatusCodes.Status400BadRequest)]
    [ProducesResponseType(typeof(ApiErrorDto), StatusCodes.Status404NotFound)]
    [ProducesResponseType(typeof(ApiErrorDto), StatusCodes.Status409Conflict)]
    [ProducesResponseType(typeof(ApiErrorDto), StatusCodes.Status500InternalServerError)]
    public IActionResult CreateRoom([FromBody] RoomDto request)
    {
        if (!ModelState.IsValid)
        {
            return ValidationProblem(ModelState);
        }

        var result = service.CreateRoom(request);
        if (!result.Success)
        {
            return result.ErrorCode switch
            {
                OperationErrorCode.NotFound => NotFound(new ApiErrorDto { Message = result.Error ?? "Room not found." }),
                OperationErrorCode.Conflict => Conflict(new ApiErrorDto { Message = result.Error ?? "Conflict error." }),
                OperationErrorCode.ValidationFailed => BadRequest(new ValidationProblemDetails
                {
                    Title = "Validation failed.",
                    Detail = result.Error,
                    Status = StatusCodes.Status400BadRequest
                }),
                _ => StatusCode(StatusCodes.Status500InternalServerError, new ApiErrorDto { Message = "An internal server error occurred." })
            };
        }

        return CreatedAtAction(nameof(GetRooms), new { id = result.Value }, new ApiMessageDto
        {
            Id = result.Value,
            Message = "Room created successfully."
        });
    }

    /// <summary>
    /// Updates an existing conference room.
    /// </summary>
    /// <param name="id">Conference room identifier.</param>
    /// <param name="request">Updated conference room data.</param>
    /// <returns>Operation result message.</returns>
    [HttpPut("{id:guid}")]
    [Consumes("application/json")]
    [ProducesResponseType(typeof(ApiMessageDto), StatusCodes.Status200OK)]
    [ProducesResponseType(typeof(ValidationProblemDetails), StatusCodes.Status400BadRequest)]
    [ProducesResponseType(typeof(ApiErrorDto), StatusCodes.Status404NotFound)]
    [ProducesResponseType(typeof(ApiErrorDto), StatusCodes.Status409Conflict)]
    [ProducesResponseType(typeof(ApiErrorDto), StatusCodes.Status500InternalServerError)]
    public IActionResult UpdateRoom(Guid id, [FromBody] RoomDto request)
    {
        if (!ModelState.IsValid)
        {
            return ValidationProblem(ModelState);
        }

        var result = service.UpdateRoom(id, request);
        if (!result.Success)
        {
            return result.ErrorCode switch
            {
                OperationErrorCode.NotFound => NotFound(new ApiErrorDto { Message = result.Error ?? "Room not found." }),
                OperationErrorCode.Conflict => Conflict(new ApiErrorDto { Message = result.Error ?? "Conflict error." }),
                OperationErrorCode.ValidationFailed => BadRequest(new ValidationProblemDetails
                {
                    Title = "Validation failed.",
                    Detail = result.Error,
                    Status = StatusCodes.Status400BadRequest
                }),
                _ => StatusCode(StatusCodes.Status500InternalServerError, new ApiErrorDto { Message = "An internal server error occurred." })
            };
        }

        return Ok(new ApiMessageDto { Id = id, Message = "Room updated successfully." });
    }

    /// <summary>
    /// Deletes a conference room.
    /// </summary>
    /// <param name="id">Conference room identifier.</param>
    /// <returns>Operation result message.</returns>
    [HttpDelete("{id:guid}")]
    [ProducesResponseType(typeof(ApiMessageDto), StatusCodes.Status200OK)]
    [ProducesResponseType(typeof(ApiErrorDto), StatusCodes.Status404NotFound)]
    [ProducesResponseType(typeof(ApiErrorDto), StatusCodes.Status409Conflict)]
    [ProducesResponseType(typeof(ApiErrorDto), StatusCodes.Status400BadRequest)]
    [ProducesResponseType(typeof(ApiErrorDto), StatusCodes.Status500InternalServerError)]
    public IActionResult DeleteRoom(Guid id)
    {
        var result = service.DeleteRoom(id);
        if (!result.Success)
        {
            return result.ErrorCode switch
            {
                OperationErrorCode.NotFound => NotFound(new ApiErrorDto { Message = result.Error ?? "Room not found." }),
                OperationErrorCode.Conflict => Conflict(new ApiErrorDto { Message = result.Error ?? "Conflict error." }),
                OperationErrorCode.ValidationFailed => BadRequest(new ApiErrorDto { Message = result.Error ?? "Validation failed." }),
                _ => StatusCode(StatusCodes.Status500InternalServerError, new ApiErrorDto { Message = "An internal server error occurred." })
            };
        }

        return Ok(new ApiMessageDto { Message = "Room deleted successfully." });
    }

    /// <summary>
    /// Finds conference rooms available for the specified period and capacity.
    /// </summary>
    /// <param name="start">Start date and time of the booking interval.</param>
    /// <param name="end">End date and time of the booking interval.</param>
    /// <param name="capacity">Required room capacity.</param>
    /// <returns>List of available conference rooms.</returns>
    [HttpGet("available")]
    [ProducesResponseType(typeof(IReadOnlyCollection<RoomDto>), StatusCodes.Status200OK)]
    [ProducesResponseType(typeof(ApiErrorDto), StatusCodes.Status400BadRequest)]
    [ProducesResponseType(typeof(ApiErrorDto), StatusCodes.Status404NotFound)]
    [ProducesResponseType(typeof(ApiErrorDto), StatusCodes.Status409Conflict)]
    [ProducesResponseType(typeof(ApiErrorDto), StatusCodes.Status500InternalServerError)]
    public IActionResult GetAvailableRooms([FromQuery] DateTime start, [FromQuery] DateTime end, [FromQuery] int capacity)
    {
        var result = service.FindAvailableRooms(start, end, capacity);
        if (!result.Success)
        {
            return result.ErrorCode switch
            {
                OperationErrorCode.NotFound => NotFound(new ApiErrorDto { Message = result.Error ?? "Not found." }),
                OperationErrorCode.Conflict => Conflict(new ApiErrorDto { Message = result.Error ?? "Conflict error." }),
                OperationErrorCode.ValidationFailed => BadRequest(new ApiErrorDto { Message = result.Error ?? "Validation failed." }),
                _ => StatusCode(StatusCodes.Status500InternalServerError, new ApiErrorDto { Message = "An internal server error occurred." })
            };
        }

        return Ok(result.Value);
    }
}
