using ConferenceRooms.Contracts;
using ConferenceRooms.Data;
using ConferenceRooms.Models;
using ConferenceRooms.Services.Results;
using Microsoft.EntityFrameworkCore;

namespace ConferenceRooms.Services;

public class ConferenceRoomService(
    ConferenceRoomsDbContext dbContext,
    IBookingCostCalculator bookingCostCalculator,
    IConferenceRoomBusinessLogic businessLogic) : IConferenceRoomService
{
    public IReadOnlyCollection<RoomDto> GetRooms()
    {
        return dbContext.Rooms
            .AsNoTracking()
            .Include(r => r.Services)
            .Select(businessLogic.MapRoomToDto)
            .ToList();
    }

    public OperationResult<Guid> CreateRoom(RoomDto request)
    {
        var validationResult = businessLogic.ValidateRoomRequest(request);
        if (!validationResult.Success)
        {
            return OperationResult<Guid>.Fail(validationResult.Error ?? "Некоректний запит.", validationResult.ErrorCode);
        }

        var room = new ConferenceRoom
        {
            Id = Guid.NewGuid(),
            Name = businessLogic.NormalizeName(request.Name),
            Capacity = request.Capacity,
            BaseHourlyRate = request.BaseHourlyRate,
            Services = businessLogic.BuildServices(request.Services)
        };

        dbContext.Rooms.Add(room);
        dbContext.SaveChanges();

        return OperationResult<Guid>.Ok(room.Id);
    }

    public OperationResult UpdateRoom(Guid id, RoomDto request)
    {
        var validationResult = businessLogic.ValidateRoomRequest(request);
        if (!validationResult.Success)
        {
            return OperationResult.Fail(validationResult.Error ?? "Некоректний запит.", validationResult.ErrorCode);
        }

        var room = dbContext.Rooms
            .Include(r => r.Services)
            .FirstOrDefault(r => r.Id == id);

        if (room is null)
        {
            return OperationResult.Fail("Зал не знайдено.", OperationErrorCode.NotFound);
        }

        room.Name = businessLogic.NormalizeName(request.Name);
        room.Capacity = request.Capacity;
        room.BaseHourlyRate = request.BaseHourlyRate;
        room.Services = businessLogic.BuildServices(request.Services);

        dbContext.SaveChanges();
        return OperationResult.Ok();
    }

    public OperationResult DeleteRoom(Guid id)
    {
        var room = dbContext.Rooms.FirstOrDefault(r => r.Id == id);
        if (room is null)
        {
            return OperationResult.Fail("Зал не знайдено.", OperationErrorCode.NotFound);
        }

        dbContext.Rooms.Remove(room);
        dbContext.SaveChanges();
        return OperationResult.Ok();
    }

    public OperationResult<IReadOnlyCollection<RoomDto>> FindAvailableRooms(DateTime start, DateTime end, int capacity)
    {
        if (end <= start)
        {
            return OperationResult<IReadOnlyCollection<RoomDto>>.Fail(
                "Кінцевий час має бути пізніше за початковий.",
                OperationErrorCode.ValidationFailed);
        }

        if (capacity < 1)
        {
            return OperationResult<IReadOnlyCollection<RoomDto>>.Fail(
                "Місткість має бути більше нуля.",
                OperationErrorCode.ValidationFailed);
        }

        var available = dbContext.Rooms
            .AsNoTracking()
            .Include(r => r.Services)
            .Where(r => r.Capacity >= capacity)
            .Where(r => !dbContext.Bookings.Any(b => b.RoomId == r.Id && businessLogic.IsOverlapping(start, end, b.Start, b.End)))
            .Select(businessLogic.MapRoomToDto)
            .ToList();

        return OperationResult<IReadOnlyCollection<RoomDto>>.Ok(available);
    }

    public OperationResult<BookingDto> CreateBooking(BookingDto request)
    {
        var bookingValidation = businessLogic.ValidateBookingRequest(request);
        if (!bookingValidation.Success)
        {
            return OperationResult<BookingDto>.Fail(bookingValidation.Error ?? "Некоректний запит.", bookingValidation.ErrorCode);
        }

        var room = dbContext.Rooms
            .Include(r => r.Services)
            .FirstOrDefault(r => r.Id == request.RoomId);

        if (room is null)
        {
            return OperationResult<BookingDto>.Fail("Зал не знайдено.", OperationErrorCode.NotFound);
        }

        var end = request.Start.AddHours(request.DurationHours);
        var overlap = dbContext.Bookings.Any(b => b.RoomId == room.Id && businessLogic.IsOverlapping(request.Start, end, b.Start, b.End));
        if (overlap)
        {
            return OperationResult<BookingDto>.Fail("На цей час зал вже заброньовано.", OperationErrorCode.Conflict);
        }

        var selectedServiceNames = request.SelectedServiceNames
            .Select(businessLogic.NormalizeName)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var selectedServices = room.Services
            .Where(s => selectedServiceNames.Contains(s.Name))
            .Select(businessLogic.CloneService)
            .ToList();

        var costs = bookingCostCalculator.Calculate(room.BaseHourlyRate, request.Start, end, selectedServices);

        var booking = new Booking
        {
            Id = Guid.NewGuid(),
            RoomId = room.Id,
            RoomName = room.Name,
            Start = request.Start,
            End = end,
            DurationHours = request.DurationHours,
            Services = selectedServices,
            RentalCost = costs.RentalCost,
            ServicesCost = costs.ServicesCost,
            TotalCost = costs.TotalCost
        };

        dbContext.Bookings.Add(booking);
        dbContext.SaveChanges();

        var response = new BookingDto
        {
            Id = booking.Id,
            RoomId = booking.RoomId,
            RoomName = booking.RoomName,
            Start = booking.Start,
            End = booking.End,
            DurationHours = booking.DurationHours,
            SelectedServiceNames = selectedServices.Select(s => s.Name).ToList(),
            SelectedServices = booking.Services.Select(businessLogic.MapServiceToDto).ToList(),
            RentalCost = booking.RentalCost,
            ServicesCost = booking.ServicesCost,
            TotalCost = booking.TotalCost,
            Message = "Бронювання успішне."
        };

        return OperationResult<BookingDto>.Ok(response);
    }

    public OperationResult<IReadOnlyCollection<RoomUtilizationReportDto>> GetRoomUtilizationReport(DateTime from, DateTime to)
    {
        if (to <= from)
        {
            return OperationResult<IReadOnlyCollection<RoomUtilizationReportDto>>.Fail(
                "Кінцева дата має бути пізніше за початкову.",
                OperationErrorCode.ValidationFailed);
        }

        var rooms = dbContext.Rooms
            .AsNoTracking()
            .Select(r => new { r.Id, r.Name })
            .ToList();

        var bookings = dbContext.Bookings
            .AsNoTracking()
            .Where(b => b.Start < to && b.End > from)
            .Select(b => new { b.RoomId, b.Start, b.End })
            .ToList();

        var bookedByRoom = bookings
            .GroupBy(b => b.RoomId)
            .ToDictionary(
                g => g.Key,
                g => new
                {
                    BookingCount = g.Count(),
                    BookedHours = g.Sum(x => businessLogic.CalculateOverlapHours(x.Start, x.End, from, to))
                });

        var availableHours = (to - from).TotalHours;

        var report = rooms
            .Select(room =>
            {
                bookedByRoom.TryGetValue(room.Id, out var bookedData);
                var bookedHours = bookedData?.BookedHours ?? 0;
                var bookingCount = bookedData?.BookingCount ?? 0;
                var utilizationPercent = availableHours > 0
                    ? Math.Round((bookedHours / availableHours) * 100, 2)
                    : 0;

                return new RoomUtilizationReportDto
                {
                    RoomId = room.Id,
                    RoomName = room.Name,
                    BookingCount = bookingCount,
                    BookedHours = Math.Round(bookedHours, 2),
                    AvailableHours = Math.Round(availableHours, 2),
                    UtilizationPercent = utilizationPercent
                };
            })
            .OrderByDescending(x => x.UtilizationPercent)
            .ThenBy(x => x.RoomName)
            .ToList();

        return OperationResult<IReadOnlyCollection<RoomUtilizationReportDto>>.Ok(report);
    }
}
