using ConferenceRooms.Contracts;
using ConferenceRooms.Services;
using ConferenceRooms.Services.Results;
using Microsoft.AspNetCore.Mvc;

namespace ConferenceRooms.Controllers;

/// <summary>
/// Керує конференц-залами: створенням, оновленням, видаленням та пошуком доступних залів.
/// </summary>
[ApiController]
[Route("api/rooms")]
public class RoomsController(IConferenceRoomService service) : ControllerBase
{
    /// <summary>
    /// Повертає список усіх залів.
    /// </summary>
    /// <returns>Колекція залів.</returns>
    [HttpGet]
    [ProducesResponseType(StatusCodes.Status200OK)]
    public IActionResult GetRooms()
    {
        var rooms = service.GetRooms();
        return Ok(rooms);
    }

    /// <summary>
    /// Повертає зал за ідентифікатором.
    /// </summary>
    /// <param name="id">Ідентифікатор залу.</param>
    /// <returns>Зал або помилку, якщо його не знайдено.</returns>
    [HttpGet("{id:guid}")]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public IActionResult GetRoom(Guid id)
    {
        var result = service.GetRoom(id);
        if (!result.Success)
        {
            return ToActionResult(result);
        }

        return Ok(result.Value);
    }

    /// <summary>
    /// Створює новий конференц-зал.
    /// </summary>
    /// <param name="request">Дані залу.</param>
    /// <returns>Ідентифікатор створеного залу.</returns>
    [HttpPost]
    [ProducesResponseType(StatusCodes.Status201Created)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public IActionResult CreateRoom([FromBody] RoomDto request)
    {
        if (!ModelState.IsValid)
        {
            return ValidationProblem(ModelState);
        }

        var result = service.CreateRoom(request);
        if (!result.Success)
        {
            return ToActionResult(result);
        }

        return CreatedAtAction(nameof(GetRoom), new { id = result.Value }, new { Id = result.Value, Message = "Зал успішно створено." });
    }

    /// <summary>
    /// Оновлює дані конференц-залу.
    /// </summary>
    /// <param name="id">Ідентифікатор залу.</param>
    /// <param name="request">Оновлені дані.</param>
    /// <returns>Підтвердження оновлення.</returns>
    [HttpPut("{id:guid}")]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public IActionResult UpdateRoom(Guid id, [FromBody] RoomDto request)
    {
        if (!ModelState.IsValid)
        {
            return ValidationProblem(ModelState);
        }

        var result = service.UpdateRoom(id, request);
        if (!result.Success)
        {
            return ToActionResult(result);
        }

        return Ok(new { Id = id, Message = "Інформацію про зал оновлено." });
    }

    /// <summary>
    /// Видаляє конференц-зал.
    /// </summary>
    /// <param name="id">Ідентифікатор залу.</param>
    /// <returns>Підтвердження видалення.</returns>
    [HttpDelete("{id:guid}")]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public IActionResult DeleteRoom(Guid id)
    {
        var result = service.DeleteRoom(id);
        if (!result.Success)
        {
            return ToActionResult(result);
        }

        return Ok(new { Message = "Зал видалено." });
    }

    /// <summary>
    /// Повертає доступні зали для заданого проміжку часу та місткості.
    /// </summary>
    /// <param name="start">Дата та час початку.</param>
    /// <param name="end">Дата та час завершення.</param>
    /// <param name="capacity">Мінімальна місткість.</param>
    /// <returns>Список доступних залів.</returns>
    [HttpGet("available")]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public IActionResult GetAvailableRooms([FromQuery] DateTime start, [FromQuery] DateTime end, [FromQuery] int capacity)
    {
        var result = service.FindAvailableRooms(start, end, capacity);
        if (!result.Success)
        {
            return ToActionResult(result);
        }

        return Ok(result.Value);
    }

    private IActionResult ToActionResult(OperationResult result)
    {
        return result.ErrorCode switch
        {
            OperationErrorCode.NotFound => NotFound(new { Message = result.Error }),
            OperationErrorCode.Conflict => Conflict(new { Message = result.Error }),
            OperationErrorCode.ValidationFailed => BadRequest(new { Message = result.Error }),
            _ => StatusCode(StatusCodes.Status500InternalServerError, new { Message = "Виникла внутрішня помилка." })
        };
    }
}
